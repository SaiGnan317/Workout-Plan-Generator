        if (strcmp(user.bodyPart, "upper") == 0) {
            printf("Battle Ropes: 15 minutes\n");
            printf("Push-Up Variations: 4 sets of 20 reps\n");
        } else if (strcmp(user.bodyPart, "lower") == 0) {
            printf("Running: 30 minutes at a fast pace\n");
