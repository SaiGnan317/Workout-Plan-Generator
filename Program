            printf("Full-body circuit: 3 rounds\n");
            printf("Jump Rope (5 mins), Burpees, Mountain Climbers\n");
        }
    } else if (strcmp(user.level, "intermediate") == 0) {
        if (strcmp(user.bodyPart, "upper") == 0) {
            printf("Rowing Machine: 10 minutes\n");
            printf("High-Knee Drills: 3 sets of 20 reps\n");
        } else if (strcmp(user.bodyPart, "lower") == 0) {
            printf("Running: 20 minutes\n");
