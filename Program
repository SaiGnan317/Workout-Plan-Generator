            printf("Full-body stretching routine:\n");
            printf("Shoulder Stretch, Hamstring Stretch, Quad Stretch\n");
        }
    } else if (strcmp(user.level, "intermediate") == 0) {
        if (strcmp(user.bodyPart, "upper") == 0) {
            printf("Chest Opener Stretch: 45 seconds\n");
            printf("Cross-Body Shoulder Stretch: 3 sets of 30 seconds\n");
